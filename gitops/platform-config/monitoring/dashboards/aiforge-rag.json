{
  "uid": "aiforge-rag",
  "title": "AIForge / RAG apps + cost",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "aiforge"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests/min (all apps)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rag_requests_total[5m])) * 60"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "p95 latency",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rag_request_duration_seconds_bucket[5m])))"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "'I don't know' ratio (quality signal)",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rag_unanswered_total[30m])) / clamp_min(sum(rate(rag_requests_total{status=\"ok\"}[30m])), 1e-9)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error ratio",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(rag_requests_total{status=\"error\"}[5m])) or vector(0)) / clamp_min(sum(rate(rag_requests_total[5m])) or vector(0), 1e-9)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests/sec by app",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (rate(rag_requests_total[5m]))",
          "legendFormat": "{{namespace}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Latency p50 / p95 by app",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, namespace) (rate(rag_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{namespace}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, namespace) (rate(rag_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{namespace}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "LLM tokens/min by app (gateway usage)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, type) (rate(rag_llm_tokens_total[5m])) * 60",
          "legendFormat": "{{namespace}} {{type}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Retrieval latency p95 (Qdrant)",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, namespace) (rate(rag_retrieval_duration_seconds_bucket[5m])))",
          "legendFormat": "{{namespace}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Infra cost per namespace (OpenCost, USD/month run-rate)",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace) (container_cpu_allocation * on(node) group_left() avg by (node) (node_cpu_hourly_cost)) * 730 + sum by (namespace) (container_memory_allocation_bytes / 1024 / 1024 / 1024 * on(node) group_left() avg by (node) (node_ram_hourly_cost)) * 730",
          "legendFormat": "{{namespace}}"
        }
      ]
    }
  ]
}